# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 마세요.

# 주인 비밀 키. 주인 화면(/owner)과 MCP(Bearer 토큰)에 같이 씁니다.
# 만드는 법: openssl rand -hex 32
OWNER_KEY=

# 화면 맨 위 제목
SITE_TITLE=시호와 약속 잡기

# 이 날짜까지만 신청을 받습니다 (YYYY-MM-DD). 비우면 오늘부터 90일까지.
BOOKING_UNTIL=2027-01-24

# 1 이면 빈 DB에 예시 데이터를 넣습니다. 실제 서버에서는 비워 두세요.
SEED_DEMO=
